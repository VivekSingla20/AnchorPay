# Copy to .env. Never commit the real .env (it is git-ignored).

# Reproducibility. Every stochastic process in this codebase (data generation,
# baseline tie-breaking, LLM sampling) is seeded from this single value.
RECOVERY_ENGINE_SEED=42

# Feature flag. When false (default), classify/intervene/copy stages use their
# deterministic fallback paths only — no network calls, no API key needed,
# fully reproducible. Set to true to opt into real LLM calls.
RECOVERY_ENGINE_USE_LLM=false

# Only read when RECOVERY_ENGINE_USE_LLM=true. Requires
# `pip install -r requirements-llm.txt`.
ANTHROPIC_API_KEY=

# Model id used when RECOVERY_ENGINE_USE_LLM=true.
RECOVERY_ENGINE_MODEL=claude-sonnet-4-5

# Per-call timeout in seconds before falling back to the deterministic path.
RECOVERY_ENGINE_LLM_TIMEOUT_SECONDS=8
